node_modules
dist
.DS_Store

# --- 素材の元データ ---
# 変換前の FBX、落としてきたモデル、FBX に付いてくるテクスチャ (.fbm)、
# Poly Haven の .blend フォルダ。合計 800MB 以上あり、一度変換したら普段は触らない。
# どの FBX がどのクリップになったかは tools/soldier.json に記録がある。
tools/raw/
# Blender の自動退避 (stage.blend1)
*.blend[0-9]
*.fbx
*.rar
*.zip

# --- 変換の中間物 ---
# public/ に入った glb と jpg は成果物なので追跡する (数 MB)。
# **手で編集する .blend は元データなので追跡する。**
#
# ステージは tools/stage_*.blend (stage_mall.blend など)。テクスチャを抱えて
# 数 MB あるが、**手で作った物は作り直せない**ので中に入れる。生成物と違って
# script から起こせない。
# 配布モデルを変換した中間物。ステージに焼き込まれた分が public/ にあるので、
# これ自体は成果物ではない。作り直す手順は tools/convert_car.py と CREDITS.md。
tools/props/

# --- 秘密 ---
# Supabase の URL と鍵。anon key は公開前提のものだが、
# プロジェクトごとに違うので追跡しない
.env
.env.local
