{
  /* 画面。DOM と Vite の型を持つ */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  },
  "include": ["src"],
  /* 試験は tsconfig.test.json が見る (bun の型が要る) */
  "exclude": ["src/**/*.test.ts"]
}
