{
  /* 画面。DOM と Vite の型を持つ */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    /* 画面の試験 (src/game/*.test.ts) が bun の型を使う */
    "types": ["vite/client", "bun-types"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  },
  "include": ["src"],
  /*
   * 共有の層の試験は tsconfig.test.json が見る。
   * **画面まわりの試験だけはここ** — DOM と three が要るので向こうでは通らない。
   */
  "exclude": ["src/domain/**/*.test.ts", "src/sim/**/*.test.ts"]
}
