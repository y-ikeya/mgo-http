# Supabase。実際の値は .env に置く (追跡しない)。
#
# VITE_ が付いたものだけブラウザのバンドルに入る。publishable key は
# 公開前提の鍵なので、それでよい (守っているのは鍵の秘匿ではなく RLS)。
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_<...>

# サーバーが署名を確かめる先。JWKS を取りに行くだけで、秘密鍵は持たない
SUPABASE_URL=https://<project>.supabase.co

# 戦績を書くための鍵。**これだけは本物の秘密**なので、絶対に VITE_ を付けない
# (付けるとバンドルに入って全世界に配られる)。
#
# 渡してあるのは record_match_player / close_match の 2 本を呼ぶ権利だけで、
# 表への直接の書き込みは revoke してある (deploy/schema.sql)。
#
# **無くても対戦はできる。** 設定しなければ戦績を残さないだけ
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<...>
